# =====================================================================
# MyPropMate - active pipeline (IMAP -> parse -> SQLite -> Excel/PDF -> SMTP)
# =====================================================================

# --- Inbox we watch for Interac e-Transfers (IMAP + Gmail app password) ---
IMAP_HOST=imap.gmail.com
IMAP_EMAIL=c.lawrence908@gmail.com
IMAP_PASSWORD=your-gmail-app-password        # 16-char app password, no spaces

# --- Outgoing mail for receipts (send from the SAME account tenants pay) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=c.lawrence908@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_NAME=Chris Lawrence
SMTP_FROM_ADDRESS=c.lawrence908@gmail.com

# --- Files / storage (container paths shown; override for local runs) ---
TEMPLATE_PATH=/app/templates/rental_receipt_template.xlsx
RECEIPTS_DIR=/app/receipts
DB_PATH=/app/data/mypropmate.db
TENANTS_SEED_PATH=/app/data/tenants.json
SOFFICE_BIN=soffice

# --- Telegram confirm-to-send (optional) ---
# Create a bot with @BotFather, then message the bot once so it can reach you.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=your-numeric-chat-id

# --- Behaviour ---
LANDLORD_EMAIL=c.lawrence908@gmail.com
AMOUNT_TOLERANCE=0.01
POLL_INTERVAL_MINUTES=5

