# Environment
.env
.env.local

# Credentials (keep template, ignore actual secrets)
credentials/*.json
!credentials/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
.venv/

# Node (if any frontend later)
node_modules/
npm-debug.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# Docker
*.log

# OS
.DS_Store
Thumbs.db

# Excel templates (keep originals, ignore generated)
Updated_*.xlsx

